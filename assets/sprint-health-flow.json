          "label": "🧹 Python — Calcular Métricas",
          "type": "PythonFunction",
          "node": {
            "template": {
              "code": "import json\ndata = json.loads(input_text)\nissues = data.get('issues',[])\ntotal = len(issues)\ndone = sum(1 for i in issues if i['fields']['status']['name']=='Concluído')\nin_progress = sum(1 for i in issues if i['fields']['status']['name']=='Em andamento')\nreturn json.dumps({'total':total,'done':done,'in_progress':in_progress,'pct':round(100*done/total,1) if total else 0})"
            }
          }
        }
      },
